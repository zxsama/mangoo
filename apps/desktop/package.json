{
  "name": "@megle/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm --prefix ../.. run dev",
    "test": "node --no-warnings --import ./tests/filter-sqlite-experimental-warning.mjs --experimental-strip-types --test tests/*.test.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/preload.cjs', 'dist/preload.cjs')\""
  },
  "dependencies": {
    "@megle/core-client": "*",
    "electron": "43.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
