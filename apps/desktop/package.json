{
  "name": "@mangoo/desktop",
  "productName": "Mangoo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm --prefix ../.. run dev",
    "test": "node --no-warnings --import ./tests/filter-sqlite-experimental-warning.mjs --import ./tests/register-source-imports.mjs --experimental-strip-types --test tests/*.test.mts",
    "pretypecheck": "npm --workspace @mangoo/plugin-image-viewer run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm --workspace @mangoo/plugin-image-viewer run build && node ../../tools/build/generate-desktop-icon.mjs",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'); const channels=fs.readFileSync('src/notification-ipc-channels.cjs','utf8'); const preload=fs.readFileSync('src/preload.cjs','utf8'); fs.writeFileSync('dist/preload.cjs', channels+'\\n'+preload); fs.copyFileSync('src/notification-ipc-channels.cjs','dist/notification-ipc-channels.cjs')\"",
    "build:package": "npm --prefix ../.. run build:desktop-package"
  },
  "dependencies": {
    "@mangoo/core-client": "*",
    "@mangoo/notification-contract": "*",
    "electron": "43.1.0",
    "@mangoo/plugin-image-viewer": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
