{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mangoo.local/contracts/plugins/manifest.schema.json",
  "title": "Mangoo Plugin Manifest v2",
  "type": "object",
  "required": ["manifestVersion", "id", "name", "version", "engine", "activationEvents", "requestedPermissions"],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9-]*)+$", "maxLength": 255 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$", "maxLength": 128 },
    "engine": { "enum": ["process", "host"] },
    "host": { "$ref": "#/$defs/hostDeclaration" },
    "entry": { "$ref": "#/$defs/processEntry" },
    "rpc": { "$ref": "#/$defs/rpc" },
    "activationEvents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["sync-enabled", "auth-requested", "diagnostics-requested", "file-decode-requested", "file-open-requested"] } },
    "requestedPermissions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/permission" } },
    "integrity": { "type": "object", "required": ["sha256"], "additionalProperties": false, "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "contributions": { "$ref": "#/$defs/contributions" }
  },
  "allOf": [{"if":{"properties":{"engine":{"const":"host"}}},"then":{"required":["host"],"not":{"anyOf":[{"required":["entry"]},{"required":["rpc"]},{"required":["integrity"]},{"required":["contributions"]}]},"properties":{"activationEvents":{"items":{"enum":["file-open-requested","diagnostics-requested"]}},"requestedPermissions":{"items":{"$ref":"#/$defs/hostEnginePermission"}}}},"else":{"required":["entry","rpc","integrity"],"not":{"required":["host"]},"properties":{"activationEvents":{"items":{"not":{"const":"file-open-requested"}}},"requestedPermissions":{"items":{"not":{"$ref":"#/$defs/hostEnginePermission"}}}}}},{"if":{"properties":{"engine":{"const":"process"}}},"then":{"if":{"properties":{"rpc":{"properties":{"capabilities":{"const":["file-decoder.v1"]}}}}},"then":{"not":{"required":["contributions"]},"properties":{"activationEvents":{"items":{"enum":["file-decode-requested","diagnostics-requested"]}},"requestedPermissions":{"items":{"type":"object","required":["kind","maxBytes"],"additionalProperties":false,"properties":{"kind":{"const":"temp-storage"},"maxBytes":{"type":"integer","minimum":1,"maximum":268435456}}}}}},"else":{"properties":{"activationEvents":{"items":{"enum":["sync-enabled","auth-requested","diagnostics-requested"]}}}}}},{"if":{"properties":{"engine":{"const":"process"}}},"then":{"if":{"required":["contributions"],"properties":{"contributions":{"required":["ui"]}}},"then":{"properties":{"requestedPermissions":{"contains":{"required":["kind","operations"],"properties":{"kind":{"const":"host-ui"},"operations":{"contains":{"const":"core-api"}}}}}}}}}],
  "$defs": {
    "contributions": { "type": "object", "additionalProperties": false, "required": ["configuration", "authentication", "presentation", "primaryCredential"], "properties": {
      "configuration": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/configurationField" } },
      "ui": { "$ref": "#/$defs/uiContribution" },
      "authentication": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/authenticationContribution" }] },
      "presentation": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/presentationContribution" }] },
      "primaryCredential": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["namespace", "purpose"], "properties": { "namespace": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }, "purpose": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } } }] }
    } },
    "configurationField": { "type": "object", "additionalProperties": false, "required": ["id", "label", "description", "format", "required", "environment", "defaultValue", "choices", "hidden", "debugOnly"], "properties": {
      "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,63}$" }, "label": { "type": "string", "minLength": 1, "maxLength": 128 }, "description": { "type": "string", "maxLength": 2048 },
      "format": { "enum": ["uuid", "text", "choice", "https-url", "loopback-url"] }, "required": { "type": "boolean" }, "environment": { "type": ["string", "null"], "pattern": "^MANGOO_[A-Z0-9_]{1,100}$" }, "defaultValue": { "type": ["string", "null"], "maxLength": 2048 }, "choices": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }, "hidden": { "type": "boolean" }, "debugOnly": { "type": "boolean" }
    } },
    "authenticationContribution": { "type": "object", "additionalProperties": false, "required": ["modes", "authorizationHosts", "manualRedirectUri", "loopbackRedirectPath", "ignoredCallbackFields"], "properties": {
      "modes": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["loopback", "manual-response-uri", "host-callback"] } }, "authorizationHosts": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "maxLength": 253 } }, "manualRedirectUri": { "type": ["string", "null"], "maxLength": 2048 }, "loopbackRedirectPath": { "type": ["string", "null"], "maxLength": 256 }, "ignoredCallbackFields": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
    } },
    "presentationContribution": { "type": "object", "additionalProperties": false, "required": ["setupLabel", "accountLabel", "icon", "helpLinks", "setupSteps"], "properties": {
      "setupLabel": { "type": "string", "minLength": 1, "maxLength": 128 }, "accountLabel": { "type": "string", "minLength": 1, "maxLength": 128 }, "icon": { "enum": ["cloud", "storage"] }, "helpLinks": { "type": "array", "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["id", "label", "url"], "properties": { "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,63}$" }, "label": { "type": "string", "minLength": 1, "maxLength": 128 }, "url": { "type": "string", "maxLength": 2048 } } } }, "setupSteps": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["title", "body", "helpLinkId"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 128 }, "body": { "type": "string", "maxLength": 2048 }, "helpLinkId": { "type": ["string", "null"], "maxLength": 64 } } } }
    } },
    "uiContribution": { "type": "object", "additionalProperties": false, "required": ["apiVersion", "entry", "sha256", "views"], "properties": {
      "apiVersion": { "const": 1 },
      "entry": { "type": "string", "maxLength": 512, "pattern": "^(?:[A-Za-z0-9_-](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.html$" },
      "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "views": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/uiView" } }
    } },
    "uiView": { "type": "object", "additionalProperties": false, "required": ["id", "title", "slot"], "properties": {
      "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$" },
      "title": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
      "slot": { "enum": ["library-menu", "library-settings", "plugin-detail", "root-menu", "notification-center"] }
    } },
    "hostUiPermission": { "type": "object", "additionalProperties": false, "required": ["kind", "operations"], "properties": {
      "kind": { "const": "host-ui" },
      "operations": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["core-api", "pick-folder", "reveal-path", "clipboard-write", "external-link"] } }
    } },
    "relativeEntry": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000]+$" },
    "processEntry": { "type": "object", "minProperties": 1, "additionalProperties": false, "properties": { "windowsX64": { "$ref": "#/$defs/relativeEntry" }, "linuxX64": { "$ref": "#/$defs/relativeEntry" } } },
    "rpc": {"oneOf":[{"type":"object","required":["wireVersions","capabilities","methodVersions"],"additionalProperties":false,"properties":{"wireVersions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":65535}},"capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["sync-provider.v1"]},"maxItems":1},"methodVersions":{"type":"object","required":["describe","health","diagnostics","shutdown","auth.begin","auth.complete","auth.poll","auth.cancel","auth.status","auth.sign_out","delta.list","object.head","object.get","object.get_range","object.put_immutable","upload.begin","upload.write","upload.commit","upload.abort"],"additionalProperties":false,"properties":{"describe":{"const":1},"health":{"const":1},"diagnostics":{"const":1},"shutdown":{"const":1},"auth.begin":{"const":1},"auth.complete":{"const":1},"auth.poll":{"const":1},"auth.cancel":{"const":1},"auth.status":{"const":1},"auth.sign_out":{"const":1},"delta.list":{"const":1},"object.head":{"const":1},"object.get":{"const":1},"object.get_range":{"const":1},"object.put_immutable":{"const":1},"upload.begin":{"const":1},"upload.write":{"const":1},"upload.commit":{"const":1},"upload.abort":{"const":1}}}}},{"type":"object","required":["wireVersions","capabilities","methodVersions","decoder"],"additionalProperties":false,"properties":{"wireVersions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":65535}},"capabilities":{"const":["file-decoder.v1"]},"methodVersions":{"type":"object","required":["health","diagnostics","shutdown","decoder.decode"],"additionalProperties":false,"properties":{"health":{"const":1},"diagnostics":{"const":1},"shutdown":{"const":1},"decoder.decode":{"const":1}}},"decoder":{"type":"object","required":["implementationVersion","extensions","purposes"],"additionalProperties":false,"properties":{"implementationVersion":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$","maxLength":128},"extensions":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]{1,16}$"}},"purposes":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"enum":["thumbnail","preview"]}}}}}}]},
    "networkPermission": { "type": "object", "required": ["kind", "schemes", "hosts"], "additionalProperties": false, "properties": { "kind": { "const": "network" }, "schemes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "const": "https" } }, "hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))+$", "maxLength": 253 } } } },
    "oauthLoopbackPermission": { "type": "object", "required": ["kind", "mode"], "additionalProperties": false, "properties": { "kind": { "const": "oauth-loopback" }, "mode": { "const": "ephemeral-only" } } },
    "secretPermission": { "type": "object", "required": ["kind", "namespace", "operations"], "additionalProperties": false, "properties": { "kind": { "const": "secret" }, "namespace": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }, "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["read", "write", "delete"] } } } },
    "tempStoragePermission": { "type": "object", "required": ["kind", "maxBytes"], "additionalProperties": false, "properties": { "kind": { "const": "temp-storage" }, "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 } } },
    "hostDeclaration": { "type": "object", "additionalProperties": false, "required": ["capabilities"], "properties": { "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["image-viewer.v1"] } } } },
    "localFilesPermission": { "type": "object", "required": ["kind", "access"], "additionalProperties": false, "properties": { "kind": { "const": "local-files" }, "access": { "const": "opened-folders" } } },
    "fileAssociationPermission": { "type": "object", "required": ["kind", "scope"], "additionalProperties": false, "properties": { "kind": { "const": "file-association" }, "scope": { "const": "current-user" } } },
    "hostEnginePermission": { "oneOf": [{ "$ref": "#/$defs/localFilesPermission" }, { "$ref": "#/$defs/fileAssociationPermission" }] },
    "permission": { "oneOf": [{ "$ref": "#/$defs/localFilesPermission" }, { "$ref": "#/$defs/fileAssociationPermission" }, { "$ref": "#/$defs/networkPermission" }, { "$ref": "#/$defs/oauthLoopbackPermission" }, { "$ref": "#/$defs/secretPermission" }, { "$ref": "#/$defs/tempStoragePermission" }, { "$ref": "#/$defs/hostUiPermission" }] }
  }
}
