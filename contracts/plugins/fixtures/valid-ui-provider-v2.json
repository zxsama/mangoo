{
  "manifestVersion": 2,
  "id": "com.example.ui",
  "name": "Example UI Provider",
  "version": "1.0.0",
  "engine": "process",
  "entry": { "windowsX64": "bin/provider.exe", "linuxX64": "bin/provider" },
  "rpc": { "wireVersions": [1], "capabilities": ["sync-provider.v1"], "methodVersions": { "describe": 1, "health": 1, "diagnostics": 1, "shutdown": 1, "auth.begin": 1, "auth.complete": 1, "auth.poll": 1, "auth.cancel": 1, "auth.status": 1, "auth.sign_out": 1, "delta.list": 1, "object.head": 1, "object.get": 1, "object.get_range": 1, "object.put_immutable": 1, "upload.begin": 1, "upload.write": 1, "upload.commit": 1, "upload.abort": 1 } },
  "activationEvents": ["sync-enabled", "auth-requested"],
  "requestedPermissions": [{ "kind": "host-ui", "operations": ["core-api", "pick-folder", "reveal-path", "clipboard-write", "external-link"] }],
  "integrity": { "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" },
  "contributions": {
    "configuration": [], "authentication": null, "presentation": null, "primaryCredential": null,
    "ui": { "apiVersion": 1, "entry": "ui/index.html", "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", "views": [
      { "id": "setup", "title": "Account", "slot": "plugin-detail" },
      { "id": "settings", "title": "Settings", "slot": "library-settings" },
      { "id": "restore", "title": "Restore", "slot": "library-menu" },
      { "id": "enroll", "title": "Enroll", "slot": "root-menu" },
      { "id": "status", "title": "Status", "slot": "notification-center" }
    ] }
  }
}
