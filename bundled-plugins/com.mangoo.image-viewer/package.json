{
  "name": "@mangoo/plugin-image-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Built-in Host-engine image viewer plugin (com.mangoo.image-viewer).",
  "type": "module",
  "exports": {
    "./desktop": {
      "types": "./dist/desktop/index.d.ts",
      "default": "./dist/desktop/index.js"
    },
    "./web": {
      "types": "./src/web/index.ts",
      "default": "./src/web/index.ts"
    },
    "./shared": {
      "types": "./src/shared/index.ts",
      "default": "./src/shared/index.ts"
    }
  },
  "scripts": {
    "build": "npm --workspace @mangoo/core-client run build && tsc -p tsconfig.desktop.json",
    "typecheck": "npm run build && tsc -p tsconfig.web.json --noEmit",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mts"
  },
  "dependencies": {
    "@mangoo/core-client": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
