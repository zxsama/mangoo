{
  "manifestVersion": 2,
  "id": "com.megle.onedrive",
  "name": "Megle OneDrive Sync Provider",
  "version": "1.0.0",
  "engine": "process",
  "entry": { "windowsX64": "bin/megle-onedrive-provider.exe", "linuxX64": "bin/megle-onedrive-provider" },
  "rpc": {
    "wireVersions": [1],
    "capabilities": ["sync-provider.v1"],
    "methodVersions": {
      "describe": 1,
      "health": 1,
      "diagnostics": 1,
      "shutdown": 1,
      "auth.begin": 1,
      "auth.complete": 1,
      "auth.poll": 1,
      "auth.cancel": 1,
      "auth.status": 1,
      "auth.sign_out": 1,
      "delta.list": 1,
      "object.head": 1,
      "object.get": 1,
      "object.get_range": 1,
      "object.put_immutable": 1,
      "upload.begin": 1,
      "upload.write": 1,
      "upload.commit": 1,
      "upload.abort": 1
    }
  },
  "activationEvents": ["sync-enabled", "auth-requested", "diagnostics-requested"],
  "requestedPermissions": [
    { "kind": "network", "schemes": ["https"], "hosts": ["login.microsoftonline.com", "graph.microsoft.com"] },
    { "kind": "oauth-loopback", "mode": "ephemeral-only" },
    { "kind": "secret", "namespace": "microsoft-onedrive", "operations": ["read", "write", "delete"] },
    { "kind": "temp-storage", "maxBytes": 134217728 }
  ],
  "integrity": { "sha256": "__SHA256__" }
}
